{
  "name": "@invinite/eslint-config",
  "version": "2.1.0",
  "description": "Unified ESLint configuration for Node, React and Svelte projects",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/inviniteopen/eslint-config.git"
  },
  "type": "module",
  "main": "index.js",
  "files": [
    "index.js",
    "index.d.ts",
    "node.js",
    "node.d.ts",
    "react.js",
    "react.d.ts",
    "svelte.js",
    "svelte.d.ts",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./node": {
      "types": "./node.d.ts",
      "default": "./node.js"
    },
    "./react": {
      "types": "./react.d.ts",
      "default": "./react.js"
    },
    "./svelte": {
      "types": "./svelte.d.ts",
      "default": "./svelte.js"
    }
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint -c node.js --ignore-pattern __tests__/fixtures .",
    "lint:fix": "eslint -c node.js --ignore-pattern __tests__/fixtures . --fix",
    "format": "prettier --check --ignore-path .prettierignore .",
    "format:fix": "prettier --write --ignore-path .prettierignore .",
    "prepublishOnly": "yarn test && yarn lint && yarn format && npm pack --dry-run"
  },
  "dependencies": {
    "@eslint-react/eslint-plugin": "^5.20.5",
    "@eslint/js": "^10.0.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-svelte": "^3.23.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "typescript-eslint": "^8.70.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "eslint": "^10.11.0",
    "expect-type": "^1.3.0",
    "prettier": "^3.9.8",
    "react": "^19.3.0",
    "svelte": "^5.57.1",
    "typescript": "^6.0.2",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "eslint": ">= 9",
    "svelte": ">= 5"
  },
  "peerDependenciesMeta": {
    "svelte": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "packageManager": "yarn@4.12.0"
}
